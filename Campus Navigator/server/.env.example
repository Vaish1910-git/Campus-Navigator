# MongoDB Atlas Connection URI
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name?retryWrites=true&w=majority&appName=APP-NAME
MONGO_URI=mongodb+srv://your_username:your_password@cluster-name.mongodb.net/pccoer-navigator?retryWrites=true&w=majority&appName=PCCOER-Navigator

# Server Port
PORT=5000

# Admin Credentials
# Username for admin login
ADMIN_USERNAME=admin

# Password hash for admin (generated with bcrypt)
# Use bcrypt to hash your password: npm install -g bcryptjs, then use bcryptjs.hashSync('password', 10)
ADMIN_PASSWORD_HASH=$2a$10$your_bcrypt_hash_here
